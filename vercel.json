{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/subscribe.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/studio/", "destination": "/index.html" },
    { "source": "/notify", "destination": "/index.html" },
    { "source": "/notify/", "destination": "/index.html" }
  ]
}
